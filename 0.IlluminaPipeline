## 5.MakeCpGFiles.R
## Written by: EM Weise
## Last edited: July 2nd, 2025
## Description: use methylkit to process sorted reads and convert them to methylkit format
#-------------------------------------

# set working directory and load libraries
setwd("/home/emweise/scratch/HalibutMethylWild_Age1629/sortedbams")

library(methylKit)

# read in list of sorted bam file names (script 5 output)
tmp <- read.table("sortedfilelist.txt",header=F,sep = "\t")

# loop to run bismark alignment for each file in the sortedfilelist
#!# reference genome needs to be in the same folder that methylkit is working in or it will fail out
for(i in 1:length(tmp$V1)){
        name <- tmp$V1[i]
        idname <- as.character(strsplit(name,"_S")[[1]][1])
        processBismarkAln(location = tmp$V1[i],sample.id = idname,save.folder = "methylkit", assembly = "GCF_009819705.1_fHipHip1.pri_genomic.fa",mincov = 20, minqual = 30, read.context = "CpG")
}



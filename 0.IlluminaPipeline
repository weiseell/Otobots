## 5.SortIndex
## Written by: EM Weise
## Last edited: July 2nd, 2025
## Description: use samtools to sort and index the aligned and profiled reads
#-------------------------------------

RUNPATH=/home/emweise/projects/def-ruzza/emweise/MethylWild2023_Part3
GENOME=/home/emweise/projects/def-ruzza/emweise/referencegenome
SCR=/home/emweise/scratch/HalibutMethylWild_Age1629

cd $RUNPATH
mkdir $RUNPATH/QSTAT/SortIndex
mkdir $RUNPATH/Scripts/SortIndex

cd $SCR

ls | grep "MethylWild2025" | sed 's/_R1.*//' | sed 's/_R2.*//' | sort | uniq | while read -r line
do
echo '#!/bin/bash
#SBATCH --time=8:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=emweise@dal.ca
#SBATCH --nodes=1
#SBATCH --mem=12G
#SBATCH --cpus-per-task=32
#SBATCH -J SortIndex_'$line'
#SBATCH -o '$RUNPATH'/QSTAT/SortIndex/SortIndex.'$line'.o

module load StdEnv/2023  gcc/12.3
module load samtools/1.20

cd $SCR/aligned

# sort reads with samtools
samtools sort '$SCR'/aligned/'$line'_R1_paired_bismark_bt2_pe.deduplicated.bam -o '$SCR'/aligned/'$line'_R1_paired_bismark_bt2_pe_sorted.bam

# add samtools index
samtools index '$SCR'/aligned/'$line'_R1_paired_bismark_bt2_pe_sorted.bam

scontrol show job ${SLURM_JOB_ID}'| cat > $RUNPATH/Scripts/SortIndex/SortIndex_$line.sh

sbatch $RUNPATH/Scripts/SortIndex/SortIndex_$line.sh

done


